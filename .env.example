# Set these as secrets/environment variables in Azure Container Apps.
DB_URL=jdbc:mysql://<mysql-host>:3306/quizhub?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=<mysql-user>
DB_PASSWORD=<set-a-unique-secret>
APP_JWT_SECRET=<at-least-32-random-bytes>
CORS_ALLOWED_ORIGINS=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=<initial-admin-username>
ADMIN_BOOTSTRAP_EMAIL=<initial-admin-email>
ADMIN_BOOTSTRAP_PASSWORD=<at-least-12-characters>

# Set the frontend container's API_UPSTREAM to the private backend URL.
API_UPSTREAM=http://<backend-container-app-fqdn>
